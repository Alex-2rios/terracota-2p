# Copia este archivo como `.env.local` y ajusta la IP.
#
# IMPORTANTE: en un teléfono FÍSICO no sirve 127.0.0.1 ni localhost, porque esa
# dirección apunta al propio teléfono. Usa la IP LAN de la computadora que
# ejecuta la API (`ipconfig` en Windows -> Dirección IPv4).
#
#   Teléfono físico ....... http://192.168.1.20:8080/api/v1
#   Emulador de Android ... http://10.0.2.2:8080/api/v1
#   Simulador de iOS ...... http://127.0.0.1:8080/api/v1
#
# También puedes cambiarla sin reiniciar desde la pantalla de login,
# con el botón "Configurar servidor".

EXPO_PUBLIC_API_URL=http://192.168.1.20:8080/api/v1
