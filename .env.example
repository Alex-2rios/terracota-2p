# Copia este archivo como `.env` en esta misma carpeta antes de `docker compose up`.
# Docker Compose lo lee automáticamente. Si no existe, se usan los valores por
# defecto que trae docker-compose.yml (válidos para desarrollo local).

# ------------------------------------------------------------ PostgreSQL
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Contraseña del rol `terracota_app` que usa la API (nunca el rol postgres).
API_DB_PASSWORD=TerracotaLocal123!

# ------------------------------------------------------------------- API
# Mínimo 32 caracteres. Para producción genera una nueva:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=desarrollo-local-cambia-esta-clave-de-terracota-2026
ACCESS_TOKEN_MINUTES=480
ENVIRONMENT=development
API_PORT=8080
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8081,http://localhost:19006

# ------------------------------------------------------------------- Web
WEB_SECRET_KEY=desarrollo-local-cambia-esta-clave-de-sesion-web
WEB_PORT=5000
# Ponlo en true sólo cuando sirvas el panel por HTTPS.
SESSION_COOKIE_SECURE=false
