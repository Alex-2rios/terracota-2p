{
  "info": {
    "_postman_id": "b7d31e60-terracota-2p-0000-000000000001",
    "name": "Terracota API 2P",
    "description": "Pruebas de la API de Terracota. Ejecutar con `Run collection` EN ORDEN: la colección guarda sola los tokens y los identificadores que va necesitando.\n\nRequiere el entorno **Terracota local** (variable `baseUrl`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" }
  ],
  "item": [
    {
      "name": "00 · Sistema",
      "item": [
        {
          "name": "Salud del servicio",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/../health"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('La API responde', () => pm.response.to.have.status(200));",
            "pm.test('Estado ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
          ] } }]
        }
      ]
    },

    {
      "name": "01 · Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "admin" },
              { "key": "password", "value": "Admin123!" }
            ] },
            "url": "{{baseUrl}}/auth/token"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login correcto', () => pm.response.to.have.status(200));",
            "const cuerpo = pm.response.json();",
            "pm.test('Devuelve token', () => pm.expect(cuerpo.access_token).to.be.a('string'));",
            "pm.test('Es administrador', () => pm.expect(cuerpo.usuario.roles).to.include('administrador'));",
            "pm.collectionVariables.set('adminToken', cuerpo.access_token);",
            "pm.collectionVariables.set('adminId', cuerpo.usuario.id);"
          ] } }]
        },
        {
          "name": "Login mesero",
          "request": {
            "method": "POST",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "mesero" },
              { "key": "password", "value": "Mesero123!" }
            ] },
            "url": "{{baseUrl}}/auth/token"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login correcto', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('meseroToken', pm.response.json().access_token);"
          ] } }]
        },
        {
          "name": "Login cocina",
          "request": {
            "method": "POST",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "cocina" },
              { "key": "password", "value": "Cocina123!" }
            ] },
            "url": "{{baseUrl}}/auth/token"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login correcto', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('cocinaToken', pm.response.json().access_token);"
          ] } }]
        },
        {
          "name": "Login caja",
          "request": {
            "method": "POST",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "caja" },
              { "key": "password", "value": "Caja123!" }
            ] },
            "url": "{{baseUrl}}/auth/token"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login correcto', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('cajaToken', pm.response.json().access_token);"
          ] } }]
        },
        {
          "name": "Sesión actual (/auth/me)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{meseroToken}}" }] },
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Devuelve la identidad', () => pm.response.to.have.status(200));",
            "pm.test('Es el mesero', () => pm.expect(pm.response.json().usuario).to.eql('mesero'));"
          ] } }]
        },
        {
          "name": "NEGATIVA · Contraseña incorrecta",
          "request": {
            "method": "POST",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "mesero" },
              { "key": "password", "value": "claveIncorrecta" }
            ] },
            "url": "{{baseUrl}}/auth/token"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Rechaza el acceso (401)', () => pm.response.to.have.status(401));"
          ] } }]
        },
        {
          "name": "NEGATIVA · Sin token",
          "request": { "method": "GET", "url": "{{baseUrl}}/catalogos/mesas" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Exige autenticación (401)', () => pm.response.to.have.status(401));"
          ] } }]
        }
      ]
    },

    {
      "name": "02 · Catálogos",
      "item": [
        {
          "name": "Mesas (guarda una disponible)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{meseroToken}}" }] },
            "url": "{{baseUrl}}/catalogos/mesas"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Lista mesas', () => pm.response.to.have.status(200));",
            "const mesas = pm.response.json();",
            "const libre = mesas.find((m) => m.estado === 'DISPONIBLE');",
            "pm.test('Hay al menos una mesa libre', () => pm.expect(libre, 'ninguna mesa disponible').to.not.be.undefined);",
            "if (libre) pm.collectionVariables.set('mesaLibre', libre.numero);"
          ] } }]
        },
        {
          "name": "Productos del menú",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{meseroToken}}" }] },
            "url": "{{baseUrl}}/catalogos/productos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Lista productos', () => pm.response.to.have.status(200));",
            "const productos = pm.response.json();",
            "pm.test('Hay productos con stock', () => pm.expect(productos.length).to.be.above(0));",
            "pm.collectionVariables.set('productoClave', productos[0].clave);"
          ] } }]
        },
        {
          "name": "Categorías",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "url": "{{baseUrl}}/catalogos/categorias"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Lista categorías', () => pm.response.to.have.status(200));"
          ] } }]
        }
      ]
    },

    {
      "name": "03 · Flujo Mesero → Cocina → Caja",
      "item": [
        {
          "name": "Mesero crea el pedido",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{meseroToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mesa\": {{mesaLibre}},\n  \"items\": [\n    { \"producto_clave\": \"{{productoClave}}\", \"cantidad\": 2, \"observacion\": \"Sin azúcar\" }\n  ],\n  \"notas\": \"Pedido creado desde Postman\"\n}" },
            "url": "{{baseUrl}}/mesero/pedidos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Pedido creado (201)', () => pm.response.to.have.status(201));",
            "const pedido = pm.response.json();",
            "pm.test('Nace en PENDIENTE', () => pm.expect(pedido.estado).to.eql('PENDIENTE'));",
            "pm.test('Calcula el total', () => pm.expect(Number(pedido.total)).to.be.above(0));",
            "pm.collectionVariables.set('pedidoId', pedido.id);"
          ] } }]
        },
        {
          "name": "NEGATIVA · Mesa ya ocupada",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{meseroToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mesa\": {{mesaLibre}},\n  \"items\": [\n    { \"producto_clave\": \"{{productoClave}}\", \"cantidad\": 1 }\n  ]\n}" },
            "url": "{{baseUrl}}/mesero/pedidos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('No permite dos pedidos activos en la misma mesa', () => pm.response.to.have.status(409));"
          ] } }]
        },
        {
          "name": "NEGATIVA · Cocina no puede crear pedidos",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cocinaToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mesa\": 1,\n  \"items\": [{ \"producto_clave\": \"{{productoClave}}\", \"cantidad\": 1 }]\n}" },
            "url": "{{baseUrl}}/mesero/pedidos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Bloquea por rol (403)', () => pm.response.to.have.status(403));"
          ] } }]
        },
        {
          "name": "Cocina lista sus pedidos",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cocinaToken}}" }] },
            "url": "{{baseUrl}}/cocina/pedidos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Lista pedidos de cocina', () => pm.response.to.have.status(200));",
            "const ids = pm.response.json().map((p) => p.id);",
            "pm.test('Aparece el pedido recién creado', () => pm.expect(ids).to.include(Number(pm.collectionVariables.get('pedidoId'))));"
          ] } }]
        },
        {
          "name": "NEGATIVA · Saltarse un estado (PENDIENTE → LISTO)",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cocinaToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"estado\": \"LISTO\" }" },
            "url": "{{baseUrl}}/cocina/pedidos/{{pedidoId}}/estado"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('No deja saltarse PREPARANDO (409)', () => pm.response.to.have.status(409));"
          ] } }]
        },
        {
          "name": "Cocina: PREPARANDO",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cocinaToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"estado\": \"PREPARANDO\", \"comentario\": \"Cocina inició el pedido\" }" },
            "url": "{{baseUrl}}/cocina/pedidos/{{pedidoId}}/estado"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Actualiza el estado', () => pm.response.to.have.status(200));",
            "pm.test('Queda en PREPARANDO', () => pm.expect(pm.response.json().estado).to.eql('PREPARANDO'));"
          ] } }]
        },
        {
          "name": "Cocina: LISTO",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cocinaToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"estado\": \"LISTO\", \"comentario\": \"Pedido terminado\" }" },
            "url": "{{baseUrl}}/cocina/pedidos/{{pedidoId}}/estado"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Queda en LISTO', () => pm.expect(pm.response.json().estado).to.eql('LISTO'));"
          ] } }]
        },
        {
          "name": "NEGATIVA · Cobrar antes de entregar",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cajaToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"pedido_id\": {{pedidoId}}, \"metodo\": \"EFECTIVO\", \"monto_recibido\": 500 }" },
            "url": "{{baseUrl}}/caja/pagos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Exige que esté ENTREGADO', () => pm.expect(pm.response.code).to.be.oneOf([400, 422]));"
          ] } }]
        },
        {
          "name": "Mesero entrega el pedido",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{meseroToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"estado\": \"ENTREGADO\", \"comentario\": \"Entregado en mesa\" }" },
            "url": "{{baseUrl}}/mesero/pedidos/{{pedidoId}}/entregar"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Queda ENTREGADO', () => pm.expect(pm.response.json().estado).to.eql('ENTREGADO'));"
          ] } }]
        },
        {
          "name": "Caja lista pendientes de pago",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cajaToken}}" }] },
            "url": "{{baseUrl}}/caja/pedidos-pendientes"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Lista pendientes', () => pm.response.to.have.status(200));",
            "const ids = pm.response.json().map((p) => p.id);",
            "pm.test('Aparece el pedido entregado', () => pm.expect(ids).to.include(Number(pm.collectionVariables.get('pedidoId'))));"
          ] } }]
        },
        {
          "name": "NEGATIVA · Monto insuficiente",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cajaToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"pedido_id\": {{pedidoId}}, \"metodo\": \"EFECTIVO\", \"monto_recibido\": 1 }" },
            "url": "{{baseUrl}}/caja/pagos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Rechaza el pago incompleto', () => pm.expect(pm.response.code).to.be.oneOf([400, 422]));"
          ] } }]
        },
        {
          "name": "Caja registra el pago",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cajaToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"pedido_id\": {{pedidoId}}, \"metodo\": \"EFECTIVO\", \"monto_recibido\": 1000 }" },
            "url": "{{baseUrl}}/caja/pagos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Genera el ticket (201)', () => pm.response.to.have.status(201));",
            "const ticket = pm.response.json();",
            "pm.test('Tiene folio', () => pm.expect(ticket.folio).to.be.a('string'));",
            "pm.test('Calcula el cambio', () => pm.expect(Number(ticket.cambio)).to.be.at.least(0));",
            "pm.collectionVariables.set('ticketId', ticket.id);"
          ] } }]
        },
        {
          "name": "NEGATIVA · Cobrar dos veces",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cajaToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"pedido_id\": {{pedidoId}}, \"metodo\": \"EFECTIVO\", \"monto_recibido\": 1000 }" },
            "url": "{{baseUrl}}/caja/pagos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('No permite el doble cobro', () => pm.expect(pm.response.code).to.be.oneOf([400, 409, 422]));"
          ] } }]
        },
        {
          "name": "Caja: corte del día",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cajaToken}}" }] },
            "url": "{{baseUrl}}/caja/ventas/hoy"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Devuelve el corte', () => pm.response.to.have.status(200));",
            "pm.test('Incluye al menos un cobro', () => pm.expect(pm.response.json().pagos).to.be.above(0));"
          ] } }]
        },
        {
          "name": "Caja: tickets emitidos",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cajaToken}}" }] },
            "url": "{{baseUrl}}/caja/tickets?limite=20"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Lista tickets', () => pm.response.to.have.status(200));"
          ] } }]
        }
      ]
    },

    {
      "name": "04 · Inventario",
      "item": [
        {
          "name": "Listar inventario",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cocinaToken}}" }] },
            "url": "{{baseUrl}}/inventario/productos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Lista el inventario', () => pm.response.to.have.status(200));"
          ] } }]
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Café Postman\",\n  \"categoria\": \"Bebidas\",\n  \"descripcion\": \"Producto de prueba\",\n  \"precio\": 42.50,\n  \"stock_actual\": 30,\n  \"stock_minimo\": 10\n}" },
            "url": "{{baseUrl}}/inventario/productos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Producto creado (201)', () => pm.response.to.have.status(201));",
            "const producto = pm.response.json();",
            "pm.test('Genera la clave sin acentos', () => pm.expect(producto.clave).to.eql('cafe-postman'));",
            "pm.collectionVariables.set('productoId', producto.id);"
          ] } }]
        },
        {
          "name": "NEGATIVA · Producto duplicado",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"nombre\": \"Café Postman\", \"categoria\": \"Bebidas\", \"precio\": 10 }" },
            "url": "{{baseUrl}}/inventario/productos"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Rechaza el duplicado (409)', () => pm.response.to.have.status(409));"
          ] } }]
        },
        {
          "name": "Actualizar precio",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"precio\": 55.00 }" },
            "url": "{{baseUrl}}/inventario/productos/{{productoId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Actualiza el producto', () => pm.response.to.have.status(200));",
            "pm.test('Guarda el nuevo precio', () => pm.expect(Number(pm.response.json().precio)).to.eql(55));"
          ] } }]
        },
        {
          "name": "Ajustar existencias",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cocinaToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"stock_actual\": 3, \"stock_minimo\": 10 }" },
            "url": "{{baseUrl}}/inventario/productos/{{productoId}}/suministro"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Ajusta el stock', () => pm.response.to.have.status(200));",
            "pm.test('Detecta stock bajo', () => pm.expect(pm.response.json().estado).to.eql('BAJO'));"
          ] } }]
        },
        {
          "name": "Alertas de stock",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cocinaToken}}" }] },
            "url": "{{baseUrl}}/inventario/alertas"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Lista alertas', () => pm.response.to.have.status(200));",
            "pm.test('Incluye el producto ajustado', () => pm.expect(pm.response.json().map((p) => p.id)).to.include(Number(pm.collectionVariables.get('productoId'))));"
          ] } }]
        },
        {
          "name": "Dar de baja el producto de prueba",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "url": "{{baseUrl}}/inventario/productos/{{productoId}}"
          },
