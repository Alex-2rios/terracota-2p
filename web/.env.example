# Copia este archivo como `.env` sólo si ejecutas la web fuera de Docker.
# Con `docker compose up` las variables vienen del .env de la raíz del proyecto.

API_URL=http://localhost:8080/api/v1
SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
WEB_HOST=0.0.0.0
WEB_PORT=5000
